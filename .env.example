# Copy to .env.local for local development. Never commit .env.local.
# Only TEST keys locally. Live keys are entered by the church in Vercel.
# Turnstile test keys (Cloudflare's published test keys, see docs/TESTING.md)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Supabase (production database, auth, storage, scheduler)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (test mode locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Cron shared secret for the 15-minute reminder / social / live jobs
CRON_SECRET=
# MaxMind (visitor time zone; GeoLite2 is enough for time zones)
MAXMIND_LICENSE_KEY=
# Tawk.to (live chat widget id)
NEXT_PUBLIC_TAWKTO_ID=
# YouTube Data API (live detection, sermon import)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Meta Graph API (Facebook Page + Instagram posting) — tokens are stored
# encrypted in the database after a one-time connect in Admin, never here.
META_APP_ID=
META_APP_SECRET=
# Google OAuth (YouTube channel connect) — tokens stored encrypted in the
# database after a one-time connect in Admin, never here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
